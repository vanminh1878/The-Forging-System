# Copy to .env.prod on the droplet (never commit the real file) and replace every CHANGE_ME.
# Generate secrets with:  openssl rand -hex 24      (hex only: safe inside the database URLs)
#   JWT secret (>= 32 chars):  openssl rand -hex 32

# ---- Database ----
HVP_OWNER_PASSWORD=CHANGE_ME
# Only takes effect the first time the database volume is created.
HVP_APP_PASSWORD=CHANGE_ME

# ---- API ----
JWT_ACCESS_SECRET=CHANGE_ME
LOG_LEVEL=info
# Providers: console (OTP / push are only written to the log) | fcm
PUSH_PROVIDER=console
OTP_PROVIDER=console

# ---- Public address ----
# Domain pointing at the droplet. No domain yet? use <IP with dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
API_DOMAIN=api.example.com
PUBLIC_BASE_URL=https://api.example.com
