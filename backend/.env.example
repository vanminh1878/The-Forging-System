# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Tenancy ----
# Tenant code used when a request does not send the X-Tenant-Code header.
DEFAULT_TENANT_CODE=hvp
# IANA timezone used for "today", week boundaries (Mon-Sun) and monthly caps.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Database ----
# Runtime connection: a NON-owner, NON-superuser role so row level security applies.
DATABASE_URL=postgres://hvp_app:hvp_app_pw@localhost:5432/hvp_dev
# Migration connection: owner role (creates tables, triggers, policies).
DATABASE_MIGRATE_URL=postgres://hvp_owner:hvp_owner_pw@localhost:5432/hvp_dev

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10

# ---- Files (evidence photos, avatars) ----
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000

# ---- Background jobs ----
# Set to false to disable the in-process scheduler (e.g. when running several API replicas).
ENABLE_SCHEDULER=true

# ---- Push / OTP providers: console | fcm / console | resend ----
PUSH_PROVIDER=console
OTP_PROVIDER=console
# Required when OTP_PROVIDER=resend (OTP e-mails for register + forgot password)
# RESEND_API_KEY=re_xxx
# MAIL_FROM=HVP <no-reply@your-domain>
# Optional: blind copy of every OTP mail
# MAIL_BCC=hungphamtien43@gmail.com
